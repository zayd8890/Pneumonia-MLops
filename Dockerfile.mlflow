# MLflow tracking server, backed by Postgres (metadata) + a local volume (artifacts).
# Build:  docker build -f Dockerfile.mlflow -t pneumonia-mlflow .

FROM python:3.11-slim

RUN pip install --no-cache-dir mlflow>=2.10.0 psycopg2-binary>=2.9.0

EXPOSE 5000

CMD ["mlflow", "server", \
     "--host", "0.0.0.0", "--port", "5000", \
     "--backend-store-uri", "postgresql://mlflow:mlflow@postgres:5432/mlflow", \
     "--default-artifact-root", "/mlartifacts"]
